# Hostinger MySQL Database Configuration
# In Hostinger hPanel -> Databases -> MySQL Databases:
# Create a database & user, and if connecting remotely, add '%' or your IP in 'Remote MySQL'
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fitmanage_db

# Alternative: Single Connection String URL
# DATABASE_URL=mysql://username:password@srv1234.hstgr.io:3306/dbname

# Server Configuration
PORT=3000
JWT_SECRET=your_jwt_secret_key_here
